APP_NAME=ContextDock
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_PORT=8090
BIND_ADDRESS=127.0.0.1

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=contextdock
DB_USERNAME=contextdock
DB_PASSWORD=change_this_secret_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=contextdock_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local AI (Ollama + qwen3-embedding:0.6b)
OLLAMA_URL=http://ollama:11434

# ContextDock Paths & Retention
DOCUMENTS_PATH=/documents
BACKUPS_PATH=/backups
CONTEXT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
BACKUP_RETENTION_COUNT=7

VITE_APP_NAME="${APP_NAME}"
